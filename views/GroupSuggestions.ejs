<!DOCTYPE html>
<html lang="en">
<%- include('includes/head2') %>

<body class="group-suggestions-page">
  <%- include('includes/header') %>

  <div class="aiSuggestPage">
    <main class="aiSuggestContent">

      <div class="workspacetitleTop">
        <a href="/workspaces/<%= workspace.workspaceID %>" class="userWorkbackButDimensions">
          <img src="/images/whiteArrow.svg" alt="Back" class="userWorkbackBut">
        </a>
        <h1 class="workspaceNameTitle"><%= workspace.workspaceName %></h1>
      </div>

      <div class="suggestionsMain">
        <h1 class="suggestionsHello">Hello, <%= user.username %>.</h1>
        <p class="suggestionsSubtitle">Your Optimal Group Suggestions Await You.</p>

        <% warnings.forEach(w => { %>
          <p class="suggestionsWarning"><%= w %></p>
        <% }) %>

        <section class="optimalGroup">
          <h2>Your Optimal Group</h2>
          <p class="sectionSub">Created by using your skills and availability</p>
          <% if (group.length === 0) { %>
            <p class="suggestionsEmpty">No suggestions yet.</p>
          <% } else { %>
            <ul class="optimalGroupList">
              <% group.forEach(m => { %>
                <li class="optimalMember">
                  <% if (m.profilePicture) { %>
                    <img class="optimalAvatar" src="<%= m.profilePicture %>" alt="">
                  <% } else { %>
                    <span class="optimalAvatar"></span>
                  <% } %>
                  <span><%= m.displayName || m.username %></span>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </section>

        <% if (partner) { %>
          <section class="partnerSection">
            <h2>Your Partner in Crime</h2>
            <p class="sectionSub">Created by using your skills and availability</p>
            <button type="button" class="partnerPlanet" id="partnerPlanet" aria-label="Reveal your partner in crime"></button>
            <p class="partnerName blurred" id="partnerName"><%= partner.displayName || partner.username %></p>
            <p class="partnerBlurb">Your Partner in Crime Shares the Most Similar Skills and Availability as You Than Anyone Else!</p>
          </section>
        <% } %>
      </div>

    </main>
  </div>

  <%- include('includes/footer') %>

<script>
  const planet = document.getElementById('partnerPlanet');
  const name = document.getElementById('partnerName');
  if (planet && name) {
    planet.addEventListener('click', () => name.classList.remove('blurred'));
  }
</script>
</body>
</html>