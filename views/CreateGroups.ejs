<!DOCTYPE html>
<html lang="en">
<%- include('includes/head2') %>

<body class="create-workspace-page-body">
  <%- include('includes/header') %>

  <main class="create-workspace-page">

    <div class="create-workspace-card">
      <h1>CREATE NEW GROUP</h1>

      <form action="/groups/create" method="POST">
        <input type="hidden" name="workspaceID" value="<%= workspaceID %>" />

        <div class="form-group">
          <label for="groupName">GROUP NAME</label>
          <input
            type="text"
            id="groupName"
            name="groupName"
            placeholder="Enter the group name"
            value="<%= formData.groupName || '' %>"
            required
          />
        </div>

        <div class="form-group">
          <label for="description">DESCRIPTION</label>
          <textarea
            id="description"
            name="description"
            class="group-description"
            placeholder="Enter a short description"
          ><%= formData.description || '' %></textarea>
        </div>

        <fieldset class="group-choice-group">
          <legend>VISIBILITY</legend>
          <div class="group-choice-options">
            <label class="group-choice-option">
              <input type="radio" name="visibility" value="private" <%= formData.visibility !== 'public' ? 'checked' : '' %> />
              <span>Private</span>
            </label>
            <label class="group-choice-option">
              <input type="radio" name="visibility" value="public" <%= formData.visibility === 'public' ? 'checked' : '' %> />
              <span>Public</span>
            </label>
          </div>
        </fieldset>

        <fieldset class="group-choice-group">
          <legend>JOIN TYPE</legend>
          <div class="group-choice-options">
            <label class="group-choice-option">
              <input type="radio" name="joinType" value="request" <%= formData.joinType !== 'open' ? 'checked' : '' %> />
              <span>Request to join</span>
            </label>
            <label class="group-choice-option">
              <input type="radio" name="joinType" value="open" <%= formData.joinType === 'open' ? 'checked' : '' %> />
              <span>Open</span>
            </label>
          </div>
        </fieldset>

        <% if (errors.length > 0) { %>
          <ul class="error-list">
            <% errors.forEach(e => { %>
              <li><%= e %></li>
            <% }) %>
          </ul>
        <% } %>

        <button type="submit" class="btn-create group-create-submit">Create Group</button>
      </form>

      <a href="/workspaces/<%= workspaceID %>" class="cwbacktext">
        <img src="/images/createworkBackButton.svg" class="jwbackBut" alt="">
        Workspace
      </a>
    </div>

  </main>

</body>
</html>